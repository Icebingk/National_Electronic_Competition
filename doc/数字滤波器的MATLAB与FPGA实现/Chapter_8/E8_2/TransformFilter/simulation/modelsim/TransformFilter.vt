`timescale 1 ns/ 1 ns
module TransformFilter_vlg_tst();
// constants                                           
// general purpose registers
//reg eachvec;
// test vector input registers
reg clk,clk_data;
reg [11:0] din;
reg rst;
// wires                                               
wire clkdv;
wire [15:0]  dout;

// assign statements (if any)                          
TransformFilter i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.clkdv(clkdv),
	.din(din),
	.dout(dout),
	.rst(rst)
);

parameter clk_period=20; //??????????????????
parameter period_data=clk_period*16;//??????
parameter clk_half_period=clk_period/2;
parameter data_half_period=period_data/2;
parameter data_num=4800;  //?????????
parameter time_sim=data_num*period_data; //??????

initial
begin
	//????????????
	clk=1;
	clk_data=1;
	//?????????
	rst=1;
	#5000 rst=0;
	//?????????
	#time_sim $finish;
	//#4000 $finish;
	//????????????
end



//?????????
always                                                 
	#clk_half_period clk=~clk;

always                                                 
	#data_half_period clk_data=~clk_data;	

//?????X??????????????????

integer Pattern;
reg [11:0] stimulus[1:data_num];
initial
begin
   //????????????????\simulation\modelsim"????
	$readmemb("E8_2_Bin_s.txt",stimulus);
	Pattern=0;
	repeat(data_num)
		begin
			Pattern=Pattern+1;
			din=stimulus[Pattern];
			#period_data;//???????????????8?
		end
end




integer file_out;
initial 
begin
   //?????????????\simulation\modelsim"????                                                 
	file_out = $fopen("E8_2_dout.txt");
	if(!file_out)
		begin
			$display("could not open file!");
			$finish;
		end
end

wire rst_write;
assign rst_write = clk_data& (!rst);//????????????????????????????
wire signed [15:0] dout_s;
assign dout_s = dout;                   //??out????????????
always @(posedge rst_write )
	$fdisplay(file_out,"%d",dout_s);



