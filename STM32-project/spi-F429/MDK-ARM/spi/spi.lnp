--cpu=Cortex-M4.fp
"spi\startup_stm32f429xx.o"
"spi\main.o"
"spi\stm32f4xx_it.o"
"spi\stm32f4xx_hal_msp.o"
"spi\stm32f4xx_hal_spi.o"
"spi\stm32f4xx_hal_rcc.o"
"spi\stm32f4xx_hal_rcc_ex.o"
"spi\stm32f4xx_hal_flash.o"
"spi\stm32f4xx_hal_flash_ex.o"
"spi\stm32f4xx_hal_flash_ramfunc.o"
"spi\stm32f4xx_hal_gpio.o"
"spi\stm32f4xx_hal_dma_ex.o"
"spi\stm32f4xx_hal_dma.o"
"spi\stm32f4xx_hal_pwr.o"
"spi\stm32f4xx_hal_pwr_ex.o"
"spi\stm32f4xx_hal_cortex.o"
"spi\stm32f4xx_hal.o"
"spi\stm32f4xx_hal_exti.o"
"spi\stm32f4xx_hal_tim.o"
"spi\stm32f4xx_hal_tim_ex.o"
"spi\system_stm32f4xx.o"
