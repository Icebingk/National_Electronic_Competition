   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>The IBERT core for 7 Series FPGA GTP transceivers is customizable and designed for evaluating and monitoring GTP tranceivers. This core includes pattern generators and checkers that are implemented in FPGA logic, and access to ports and the dynamic reconfiguration port attributes of the GTP transceivers.</rdf:li>
               <rdf:li>ChipScope,7 Series,Artix,Artix-7,Artix7,GTP, transevier,IBERT,monitor,Vivado,ds874</rdf:li>
               <rdf:li>"ChipScope,7 Series,Artix,Artix-7,Artix7,GTP, transevier,IBERT,monitor,Vivado,ds874"</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-repair">The IBERT core for 7 Series FPGA GTP transceivers is customizable and designed for evaluating and monitoring GTP tranceivers. This core includes pattern generators and checkers that are implemented in FPGA logic, and access to ports and the dynamic reconfiguration port attributes of the GTP transceivers.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:modified>2013-04-01T15:43-07:00</dc:modified>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Xilinx, Inc.</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-repair">Xilinx PG133 LogiCORE IP IBERT for 7 Series GTP Transceivers v3.0, Product Guide</rdf:li>
            </rdf:Alt>
         </dc:title>
      </rdf:Description>
